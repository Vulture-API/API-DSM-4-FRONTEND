# ---------------------------------------------------------------------------
# Destinos do proxy (rewrites) do Next — variáveis de SERVIDOR.
# O navegador chama caminhos relativos (/api/...) e o Next repassa para cá.
# São gravadas no build: depois de mudar, rode `npm run build` de novo.
# ---------------------------------------------------------------------------
# Backend monolítico (todas as rotas na porta 3000).
API_SERVER_URL=http://localhost:3000
USERS_API_URL=http://localhost:3000
PROPERTIES_API_URL=http://localhost:3000
PARAMETERS_API_URL=http://localhost:3000
ALERTS_API_URL=http://localhost:3000
STATIONS_API_URL=http://localhost:3000
